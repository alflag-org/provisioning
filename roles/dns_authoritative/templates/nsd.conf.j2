server:
  username: nsd
  zonesdir: "{{ dns_authoritative_zone_dir }}"
{% for address in dns_authoritative_listen_addresses | unique %}
  ip-address: {{ address }}
{% endfor %}
{% if dns_authoritative_control_enabled %}
remote-control:
  control-enable: yes
  control-interface: "{{ dns_authoritative_control_socket }}"
{% endif %}

{% for zone in dns_authoritative_prepared_zones %}
zone:
  name: "{{ zone.name }}"
  zonefile: "{{ zone.file | default(dns_authoritative_zone_dir ~ '/' ~ zone.name ~ '.zone') }}"

{% endfor %}
