[Unit]
Description=Zabbix PostgreSQL and configuration recovery backup
After=postgresql.service
RequiresMountsFor={{ zabbix_backup_mount }}

[Service]
Type=oneshot
ExecStart=/usr/local/sbin/zabbix-recovery backup
TimeoutStartSec=30min
KillMode=control-group
UMask=0077
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
