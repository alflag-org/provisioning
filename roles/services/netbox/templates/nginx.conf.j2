server {
    listen {{ services_netbox_nginx_listen_address }}:{{ services_netbox_nginx_port }};
    server_name {{ services_netbox_nginx_server_names | join(' ') }};

    location /static/ {
        alias {{ services_netbox_static_path }}/;
    }

    location / {
        proxy_pass http://{{ services_netbox_gunicorn_bind_address }}:{{ services_netbox_gunicorn_port }};
        proxy_set_header Host $http_host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
