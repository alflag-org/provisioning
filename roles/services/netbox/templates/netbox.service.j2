[Unit]
Description=NetBox WSGI Service
Documentation=https://docs.netbox.dev/
After=network-online.target {{ netbox_postgresql_service_name }}.service {{ netbox_redis_service_name }}.service
Wants=network-online.target

[Service]
Type=simple
User={{ netbox_user }}
Group={{ netbox_group }}
PIDFile=/var/tmp/netbox.pid
WorkingDirectory={{ netbox_root }}
ExecStart={{ netbox_venv_path }}/bin/gunicorn --pid /var/tmp/netbox.pid --pythonpath {{ netbox_root }}/netbox --config {{ netbox_gunicorn_config_path }} netbox.wsgi
Restart=on-failure
RestartSec=30
PrivateTmp=true

[Install]
WantedBy=multi-user.target
