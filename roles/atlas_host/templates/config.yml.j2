runtime:
  python:
    version: "{{ atlas_runtime_python_version }}"
{% if atlas_runtime_python_executable | default('') | length > 0 %}
    executable: "{{ atlas_runtime_python_executable }}"
{% endif %}

programs:
{% if atlas.programs | length == 0 %}
  {}
{% else %}
{% for name, program in atlas.programs.items() %}
  {{ name }}:
    root: "{{ program.root }}"
    runtime:
      type: "{{ program.runtime.type }}"
{% if program.runtime.type in ['python', 'perl'] %}
{% if program.runtime.version | default('') | length > 0 %}
      version: "{{ program.runtime.version }}"
{% endif %}
{% if program.runtime.environment | default('') | length > 0 %}
      environment: "{{ program.runtime.environment }}"
{% endif %}
{% endif %}
{% endfor %}
{% endif %}
